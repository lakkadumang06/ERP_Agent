# ============================================================================
# ERP-Agent configuration. Copy to .env and fill in what you have.
# Only ONE provider is needed to run the project. The UI dropdown shows every
# provider that has a key here; switch per request without restarting.
# ============================================================================

# Default provider: openai | anthropic | groq | gemini | openrouter
LLM_PROVIDER=groq

# --- Paid first-party APIs --------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Optional custom OpenAI-compatible endpoint for the "openai" provider.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Free tiers (no credit card) --------------------------------------------
# Groq: https://console.groq.com  (fastest, ~1k requests/day)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini: https://aistudio.google.com  (Flash models are free; Pro models need billing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter: https://openrouter.ai/keys  (models ending in ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free



# --- Database ---------------------------------------------------------------
# SQLite by default. For PostgreSQL: postgresql+psycopg://user:pass@host:5432/erp
DATABASE_URL=sqlite:///./data/erp.db

# --- LangSmith tracing (optional) -------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=erp-agent

LOG_LEVEL=INFO
